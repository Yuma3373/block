<resources>
    <string name="app_name">쇼츠·릴스 차단</string>
    <string name="service_description">유튜브 쇼츠 탭과 인스타그램 릴스 탭을 가리고, 쇼츠·릴스 화면이 열리면 바로 빠져나옵니다. 탭 색을 맞추려고 화면의 한 점 색만 읽으며, 화면 내용은 저장하거나 기기 밖으로 보내지 않습니다.</string>
    <string name="tagline">짧은 영상에 시간을 뺏기지 않게</string>

